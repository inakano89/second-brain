# Second Brain — exemplo de configuração (.env)
# O assistente /setup gera este arquivo automaticamente no primeiro acesso.
# Precedência: valor no .env > variável de ambiente > padrão.


# ===== Geral =====
SETUP_COMPLETED=false
# Nome do cérebro
BRAIN_NAME="Second Brain"
# Host HTTP
HTTP_HOST=0.0.0.0
# Porta HTTP
HTTP_PORT=8080
# URL pública — Usada no OAuth do Google e no bookmarklet. Ex: https://brain.exemplo.com
PUBLIC_URL=
# Timezone (IANA)
TIMEZONE=America/Sao_Paulo
# Diretório de dados — Requer reinício.
DATA_DIR=./data
# Pasta monitorada (inbox)
INBOX_DIR=./inbox
# Folder watcher ativo
WATCHER_ENABLED=true
# Após processar
WATCHER_ACTION=archive
# Workers da fila
QUEUE_WORKERS=3
# Retenção de logs (dias)
LOG_RETENTION_DAYS=90
# Limite de importação (MB) — Tamanho máximo por envio na página Importar e em /api/import.
IMPORT_MAX_MB=200

# ===== Segurança =====
# Usuário
ADMIN_USER=
# gerado pelo setup
ADMIN_PASSWORD_HASH=
# gerado pelo setup
SESSION_SECRET=
# API token (clipper/webhooks)
API_TOKEN=

# ===== Perfil =====
# Chave do cofre do Perfil — Cifra os itens sensíveis do Perfil (AES-256-GCM). Criada sozinha no primeiro uso. Guarde junto com a chave de backup: sem ela os itens sensíveis não podem ser lidos.
VAULT_KEY=
# O que a IA pode ler do Perfil — basic = itens comuns sempre; itens sensíveis (saúde, documentos, endereços) só com modelo local. full = tudo, inclusive modelos na nuvem. none = a IA nunca lê o Perfil.
PROFILE_AI_ACCESS=basic
# Criptografar todos os itens do Perfil — Desligado: só os itens marcados como sensíveis são cifrados. Ligado: todos (matrículas, datas, metas…) ficam cifrados no banco. A marca “sensível” continua decidindo o que fica oculto na tela e o que a IA pode ler.
PROFILE_ENCRYPT_ALL=false
# Lembretes no Telegram — Doses de medicação e suplementos, hábitos com horário e aulas.
REMINDERS_ENABLED=true
# Avisar aulas com antecedência (min)
REMINDERS_CLASS_BEFORE=60

# ===== LLM =====
# OpenAI API key — Guia: Ajuda → OpenAI
OPENAI_API_KEY=
# OpenAI base URL
OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo de transcrição OpenAI
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Modelo de embeddings OpenAI
OPENAI_EMBED_MODEL=text-embedding-3-small
# Anthropic (Claude) API key — Guia: Ajuda → Claude
ANTHROPIC_API_KEY=
# Google Gemini API key — Guia: Ajuda → Gemini
GEMINI_API_KEY=
# Modelo de embeddings Gemini
GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM local (OpenAI-compatible) — Ex: http://localhost:11434/v1
OLLAMA_BASE_URL=
# Embeddings locais
OLLAMA_EMBED_MODEL=nomic-embed-text
# Provedor de embeddings
EMBEDDING_PROVIDER=auto
# Override de preços (JSON) — {"modelo-prefixo":[entrada_usd_1M, saida_usd_1M]}
LLM_PRICING=
# Limiar de similaridade p/ auto-link — Vazio = automático (0.72 remoto / 0.45 local)
AUTOLINK_THRESHOLD=

# ===== Modelos =====
# Catálogo de modelos — provedor:modelo separados por vírgula
LLM_MODELS=anthropic:claude-fable-5-1,anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,anthropic:claude-haiku-4-5-20251001,openai:gpt-6-astra,openai:gpt-6-sol,openai:gpt-6-luna,gemini:gemini-3.8-flash,gemini:gemini-3.1-pro-preview,ollama:llama3.1
# Provedor padrão global
DEFAULT_LLM_PROVIDER=auto
# Modelo padrão Claude
ANTHROPIC_MODEL=claude-opus-5-5
# Modelo padrão GPT
OPENAI_MODEL=gpt-6-astra
# Modelo padrão Gemini
GEMINI_MODEL=gemini-3.1-pro-preview
# Modelo padrão local
OLLAMA_MODEL=llama3.1
# Tarefa: chat web
LLM_ROUTE_CHAT=auto
# Tarefa: Telegram
LLM_ROUTE_TELEGRAM=auto
# Tarefa: auto-tagging
LLM_ROUTE_ENRICH=auto
# Tarefa: visão/OCR
LLM_ROUTE_VISION=auto
# Tarefa: transcrição
LLM_ROUTE_TRANSCRIPTION=auto
# Tarefa: eventos
LLM_ROUTE_EVENTS=auto
# Tarefa: e-mails
LLM_ROUTE_EMAIL=auto
# Tarefa: RSS
LLM_ROUTE_RSS=auto
# Tarefa: briefing matinal
LLM_ROUTE_BRIEFING=council
# Tarefa: revisões
LLM_ROUTE_REVIEW=council
# Tarefa: tarefas de reuniões
LLM_ROUTE_ACTIONS=auto
# Tarefa: memória
LLM_ROUTE_MEMORY=auto
# Conselho: membros — provedor ou provedor:modelo
LLM_COUNCIL_MEMBERS=anthropic,openai,gemini
# Conselho: moderador
LLM_COUNCIL_JUDGE=anthropic
# Conselho: rodadas de debate
LLM_COUNCIL_ROUNDS=1

# ===== Telegram =====
# Token do bot
TELEGRAM_BOT_TOKEN=
# IDs autorizados — Separados por vírgula
ALLOWED_TELEGRAM_USER_IDS=

# ===== Google =====
# OAuth Client ID
GOOGLE_CLIENT_ID=
# OAuth Client Secret
GOOGLE_CLIENT_SECRET=
# Serviços Google — calendar, gmail, drafts (rascunhos), drive, contacts, tasks, youtube. Mudou a lista? Reconecte o Google.
GOOGLE_SERVICES=calendar,gmail,drafts,drive,contacts,tasks,youtube
# Agenda para novos eventos
GOOGLE_CALENDAR_ID=primary
# Agendas lidas — all = todas as agendas visíveis no Google Agenda; ou IDs separados por vírgula
GOOGLE_CALENDARS=all
# Importar eventos passados (dias) — Importação única do histórico da agenda; 0 desliga
GOOGLE_CALENDAR_PAST_DAYS=365
# Query de e-mails prioritários
GMAIL_QUERY="is:unread is:important newer_than:2d"
# Query de newsletters — Ex: label:newsletters newer_than:1d
GMAIL_NEWSLETTER_QUERY=
# Drive: importar arquivos alterados nos últimos N dias — 0 = todos. Vale para a primeira sincronização
DRIVE_SINCE_DAYS=365
# Drive: máx. arquivos por ciclo
DRIVE_MAX_FILES=40
# Drive: filtro extra — Sintaxe de busca do Drive. Ex: 'me' in owners
DRIVE_QUERY=

# ===== Zepp =====
# E-mail Zepp/Amazfit
ZEPP_EMAIL=
# Senha Zepp
ZEPP_PASSWORD=
# App token (alternativa ao login)
ZEPP_APP_TOKEN=
# User ID
ZEPP_USER_ID=
# API base
ZEPP_API_BASE=https://api-mifit.huami.com

# ===== RSS =====
# Feeds RSS/Atom — Um por linha ou separados por vírgula
RSS_FEEDS=
# Interesses (relevância)
RSS_INTERESTS=
# Nota mínima (0-10)
RSS_MIN_SCORE=6
# Máx. itens por ciclo
RSS_MAX_ITEMS=20

# ===== Backup =====
# Chave mestre AES-GCM
BACKUP_ENCRYPTION_KEY=
# Destinos — local,s3,webdav,telegram
BACKUP_TARGETS=local
# Snapshots locais mantidos
BACKUP_KEEP=7
# S3 endpoint — Ex: https://s3.us-east-1.amazonaws.com
S3_ENDPOINT=
# S3 região
S3_REGION=us-east-1
# S3 bucket
S3_BUCKET=
# S3 access key
S3_ACCESS_KEY=
# S3 secret key
S3_SECRET_KEY=
# S3 prefixo
S3_PREFIX=second-brain/
# S3 path-style
S3_PATH_STYLE=true
# WebDAV URL (diretório)
WEBDAV_URL=
# WebDAV usuário
WEBDAV_USER=
# WebDAV senha
WEBDAV_PASSWORD=
# Chat privado p/ backup
BACKUP_TELEGRAM_CHAT_ID=

# ===== Automação =====
# Agent actions ativas
ACTIONS_ENABLED=false
# Arquivo de ações
ACTIONS_FILE=./actions.json
# MQTT broker — tcp://host:1883 ou tls://host:8883
MQTT_BROKER=
# MQTT usuário
MQTT_USERNAME=
# MQTT senha
MQTT_PASSWORD=
# MQTT client id
MQTT_CLIENT_ID=second-brain

# ===== Atualizações =====
# Instalar atualizações automaticamente — Baixa, verifica (SHA-256/assinatura), instala e reinicia a partir das releases do GitHub.
AUTO_UPDATE_ENABLED=true
# Canal
UPDATE_CHANNEL=stable
# Repositório GitHub — owner/repo de onde as releases são baixadas
UPDATE_REPO=inakano89/second-brain
# Atualizar lista de modelos de IA automaticamente — Todo dia baixa o catálogo de modelos do repositório: adiciona modelos novos, remove os descontinuados e segue o padrão recomendado (a menos que você tenha escolhido outro).
LLM_MODELS_AUTO_SYNC=true

# ===== Agendamentos =====
# Briefing matinal
CRON_MORNING="0 7 * * *"
# Balanço noturno
CRON_EVENING="0 21 * * *"
# Weekly review
CRON_WEEKLY="0 18 * * 0"
# Tarefas de reuniões e e-mails — Cria tarefas a partir de atas, transcrições e notas de reunião novas e envia a lista do que surgiu (inclusive dos e-mails).
CRON_ACTIONS="0 12,18 * * *"
# Memória do dia — Destila decisões, aprendizados e prioridades do que entrou no dia.
CRON_MEMORY="30 22 * * *"
# Faxina semanal — Sugere duplicados para juntar, itens vazios, tarefas paradas e pessoas soltas; você aprova em Conteúdo → Faxina.
CRON_CLEANUP="30 17 * * 0"
# Lembretes do Perfil — Frequência da checagem de lembretes (doses, hábitos, aulas).
CRON_REMINDERS="*/5 * * * *"
# Manutenção
CRON_MAINTENANCE="30 3 * * *"
# Backup
CRON_BACKUP="0 4 * * *"
# RSS
CRON_RSS="*/30 * * * *"
# Gmail
CRON_GMAIL="*/15 * * * *"
# Calendar
CRON_CALENDAR="*/30 * * * *"
# Google Drive
CRON_DRIVE="20 */2 * * *"
# Contatos Google
CRON_CONTACTS="10 5 * * *"
# Google Tasks
CRON_GOOGLE_TASKS="5,35 * * * *"
# YouTube
CRON_YOUTUBE="25 5 * * *"
# Google Takeout no Drive
CRON_TAKEOUT="45 5 * * *"
# Zepp
CRON_ZEPP="0 */4 * * *"
# Verificar atualizações
CRON_UPDATE="40 4 * * *"
# Atualizar catálogo de modelos
CRON_MODELS="50 4 * * *"
